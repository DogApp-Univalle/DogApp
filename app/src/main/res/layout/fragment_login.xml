<?xml version="1.0" encoding="utf-8"?>
<!-- HU 1.0: login oscuro sin toolbar, cabeza de perro arriba-derecha, marca y huella Lottie -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dogapp_dark"
    tools:context=".view.login.LoginFragment">

    <ImageView
        android:id="@+id/ivPerro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_perro"
        android:scaleType="fitCenter"
        android:src="@drawable/perro_cabeza"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.55" />

    <TextView
        android:id="@+id/tvMarca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:fontFamily="@font/dogapp_brand"
        android:gravity="center"
        android:text="@string/login_marca"
        android:textColor="@color/white"
        android:textSize="44sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivPerro" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieHuella"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="64dp"
        android:contentDescription="@string/cd_huella"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="fingerprint.json"
        app:lottie_loop="true"
        app:lottie_renderMode="software" />

    <TextView
        android:id="@+id/tvAyuda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_16"
        android:text="@string/login_toque_huella"
        android:textColor="@color/hint_gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/lottieHuella"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
